# ==========================================
# Application & API Configuration
# ==========================================
ENVIRONMENT=development
PROJECT_NAME="ML-Based Ground/Soil Risk Prediction and Monitoring System"
VERSION=0.1.0

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@db:5432/soil_ml
# For local development without Docker:
# DATABASE_URL=sqlite:///./soil_ml.db

# ==========================================
# ML Pipeline Configuration
# ==========================================
# Reproducibility seed for all ML splits and algorithms
RANDOM_SEED=42

# Toggle inclusion of SVM in baseline models.
ENABLE_SVM=true

# Default path to the raw dataset file
DATASET_PATH=storage/datasets/urban_road_collapse_risk_dataset.csv

# Maximum allowed upload size in MB
MAX_UPLOAD_SIZE_MB=50
