# ==========================================
# ML Pipeline Configuration
# ==========================================

# Reproducibility seed for all ML splits and algorithms
RANDOM_SEED=42

# Toggle inclusion of SVM in baseline models.
# (SVM with RBF kernel is O(n^2) and may be slow on 15k rows)
ENABLE_SVM=true

# Default path to the raw dataset file
DATASET_PATH=storage/datasets/urban_road_collapse_risk_dataset.csv

# ==========================================
# Backend / Database Configuration (Future Phases)
# ==========================================
# DATABASE_URL=postgresql://user:password@db:5432/soil_ml
# MAX_UPLOAD_SIZE_MB=50
